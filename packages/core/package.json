{
  "name": "@sushichan044/kg-core",
  "version": "0.6.5",
  "description": "Framework-independent parsing, composition, and proofreading for Japanese manuscripts",
  "keywords": [
    "japanese",
    "manuscript",
    "novel",
    "pagination",
    "proofreading"
  ],
  "homepage": "https://github.com/sushichan044/kg#readme",
  "bugs": {
    "url": "https://github.com/sushichan044/kg/issues"
  },
  "license": "MIT",
  "author": {
    "name": "sushichan044",
    "url": "https://github.com/sushichan044"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sushichan044/kg.git",
    "directory": "packages/core"
  },
  "funding": "https://github.com/sponsors/sushichan044",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
