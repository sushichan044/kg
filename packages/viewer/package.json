{
  "name": "@sushichan044/kg-viewer",
  "version": "0.13.0",
  "description": "Reusable React components for vertical novel preview and diagnostic feedback",
  "keywords": [
    "japanese",
    "manuscript",
    "novel",
    "proofreading",
    "react",
    "viewer"
  ],
  "homepage": "https://github.com/sushichan044/kg#readme",
  "bugs": {
    "url": "https://github.com/sushichan044/kg/issues"
  },
  "license": "MIT",
  "author": {
    "name": "sushichan044",
    "url": "https://github.com/sushichan044"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sushichan044/kg.git",
    "directory": "packages/viewer"
  },
  "funding": "https://github.com/sponsors/sushichan044",
  "files": [
    "dist",
    "src/*.css",
    "README.md",
    "LICENSE",
    "styles.d.ts",
    "assets",
    "font-asset.d.ts"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./styles.css": {
      "types": "./styles.d.ts",
      "default": "./src/styles.css"
    },
    "./structural.css": {
      "types": "./styles.d.ts",
      "default": "./src/structural.css"
    },
    "./theme.css": {
      "types": "./styles.d.ts",
      "default": "./src/theme.css"
    },
    "./package.json": "./package.json",
    "./fonts/GenEiKoburiMin6-R.ttf": {
      "types": "./font-asset.d.ts",
      "default": "./assets/GenEiKoburiMin6-R.ttf"
    },
    "./fonts/RinMincho-Regular.ttf": {
      "types": "./font-asset.d.ts",
      "default": "./assets/RinMincho-Regular.ttf"
    },
    "./fonts/RinMincho-Bold.ttf": {
      "types": "./font-asset.d.ts",
      "default": "./assets/RinMincho-Bold.ttf"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@sushichan044/kg-core": "workspace:*",
    "harfbuzzjs": "1.6.3"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "@vitejs/plugin-react": "catalog:dev",
    "@vitest/browser-playwright": "catalog:dev",
    "oxc-transform-react": "catalog:prod",
    "playwright": "catalog:dev",
    "publint": "catalog:dev",
    "react": "catalog:prod",
    "react-dom": "catalog:prod",
    "typescript": "catalog:dev",
    "unplugin-unused": "catalog:dev",
    "valibot": "catalog:prod",
    "vite-plus": "catalog:dev",
    "vitest-browser-react": "catalog:dev"
  },
  "peerDependencies": {
    "@types/react": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
