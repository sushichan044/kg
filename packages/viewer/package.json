{
  "name": "@sushichan044/kg-viewer",
  "version": "0.0.0",
  "description": "Reusable React components for manuscript-grid preview and diagnostic feedback",
  "keywords": [
    "japanese",
    "manuscript",
    "novel",
    "proofreading",
    "react",
    "viewer"
  ],
  "homepage": "https://github.com/sushichan044/kg#readme",
  "bugs": {
    "url": "https://github.com/sushichan044/kg/issues"
  },
  "license": "MIT",
  "author": {
    "name": "sushichan044",
    "url": "https://github.com/sushichan044"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sushichan044/kg.git",
    "directory": "packages/viewer"
  },
  "funding": "https://github.com/sponsors/sushichan044",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "styles.d.ts"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./styles.css": {
      "types": "./styles.d.ts",
      "default": "./dist/style.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prebuild": "pnpm --filter @sushichan044/kg-core build",
    "build": "vp pack",
    "precheck": "pnpm --filter @sushichan044/kg-core build",
    "check": "vp check",
    "dev": "vp pack --watch",
    "prepublishOnly": "pnpm --filter @sushichan044/kg-core build && vp pack",
    "pretest": "pnpm --filter @sushichan044/kg-core build",
    "test": "vp test"
  },
  "dependencies": {
    "@sushichan044/kg-core": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@rolldown/plugin-babel": "0.2.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "playwright": "1.61.1",
    "publint": "0.3.22",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "7.0.2",
    "unplugin-unused": "0.5.7",
    "vite": "8.1.5",
    "vite-plus": "0.2.5",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
