{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [".agents/**", "internal/static/dist/**"],
  "workspaces": {
    "internal/frontend": {
      "ignoreDependencies": ["@svgr/plugin-jsx"],
      "includeEntryExports": true,
      "project": ["mock/**/*.{ts,tsx}", "src/**/*.{ts,tsx}!", "!src/**/*.test.{ts,tsx}!"]
    },
    "packages/core": {
      "entry": ["src/index.ts!", "src/lint.ts!", "src/plugin.ts!"],
      "ignoreDependencies": ["@arethetypeswrong/core", "publint", "unplugin-unused"]
    },
    "packages/viewer": {
      "ignoreDependencies": ["@arethetypeswrong/core", "publint", "unplugin-unused"],
      "project": ["font-proof/**/*.{ts,tsx}", "src/**/*.{ts,tsx}!", "!src/**/*.test.{ts,tsx}!"]
    }
  },
  "treatConfigHintsAsErrors": true,
  "treatTagHintsAsErrors": true,
  "include": [
    "files",
    "dependencies",
    "unlisted",
    "binaries",
    "unresolved",
    "catalog",
    "catalogReferences",
    "exports",
    "types",
    "nsExports",
    "nsTypes",
    "enumMembers",
    "namespaceMembers",
    "duplicates",
    "cycles"
  ],
  "rules": {
    "cycles": "error"
  }
}
