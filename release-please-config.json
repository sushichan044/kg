{
  "packages": {
    ".": {
      "release-type": "go",
      "component": "kg",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "draft": true,
      "force-tag-creation": true,
      "include-component-in-tag": false
    },
    "packages/core": {
      "release-type": "node",
      "component": "kg-core",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "draft": true
    },
    "packages/viewer": {
      "release-type": "node",
      "component": "kg-viewer",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "draft": true
    }
  },
  "plugins": [
    {
      "type": "node-workspace",
      "merge": false
    },
    {
      "type": "linked-versions",
      "groupName": "kg",
      "components": ["kg", "kg-core", "kg-viewer"]
    }
  ],
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json"
}
